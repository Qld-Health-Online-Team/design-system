{
  "name": "@qhealth-design-system/core",
  "version": "1.22.2",
  "description": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/Qld-Health-Online-Team/design-system"
  },
  "license": "MIT",
  "main": "index.js",
  "scripts": {
    "build": "webpack --config webpack/webpack.prod.js",
    "build-all": "npm run build && npm run jsdoc",
    "jsdoc": "./node_modules/jsdoc/jsdoc.js -a all -c jsdoc.json -r -R README.md ./src/components/ -d ./documentation/jsdoc",
    "lint:js": "eslint .",
    "lint:styles": "stylelint \"**/*.{css,scss}\"",
    "lint": "npm run lint:js && npm run lint:styles",
    "format": "prettier . --write --list-different",
    "format:check": "prettier . --check",
    "build-storybook": "node .storybook/prepare-storybook.js && storybook build",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project=unit",
    "test:storybook": "vitest --project=storybook"
  },
  "keywords": [],
  "author": "",
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/css": "^1.3.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.0",
    "@eslint/markdown": "^8.0.2",
    "@poliklot/prettier-plugin-handlebars": "^0.2.12",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-designs": "^11.1.3",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-themes": "^10.4.6",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/html-vite": "^10.4.6",
    "@vitest/browser-playwright": "^4.1.7",
    "autoprefixer": "^10.4.14",
    "chromatic": "^18.0.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^5.2.6",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.4.6",
    "glob": "^7.2.0",
    "globals": "^17.6.0",
    "handlebars": "^4.7.8",
    "import-glob-loader": "^1.1.0",
    "jsdoc": "^4.0.2",
    "mini-css-extract-plugin": "^2.7.6",
    "playwright": "^1.60.0",
    "postcss-loader": "^7.3.3",
    "postcss-scss": "^4.0.9",
    "prettier": "3.9.4",
    "sass": "^1.63.6",
    "sass-loader": "^13.3.2",
    "storybook": "^10.4.6",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-scss": "^7.1.0",
    "terser-webpack-plugin": "^5.3.9",
    "vite": "^7.2.6",
    "vite-plugin-sass-glob-import": "^6.0.2",
    "vitest": "^4.1.7",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4",
    "webpack-merge": "^4.2.2"
