{{#with component.data}}
  <section
    class="
      qld__body
      {{#if metadata.theme.value}}
        {{!-- The theme option value is the group class; the section takes the
              matching qld__body modifier --}}
        {{replace metadata.theme.value 'qld__accordion-group--' 'qld__body--'}}
      {{/if}}
    "
  >
    <div class="container-fluid">

      {{#if metadata.heading.value}}
        <h2>
          {{ metadata.heading.value }}
        </h2>
      {{/if}}

      {{#if metadata.intro.value}}
        {{{ metadata.intro.value }}}
      {{/if}}
      <div
        id="{{#if metadata.id_field.value}}{{{ metadata.id_field.value }}}{{else}}accordion-{{ assetid }}{{/if}}"
        class="
          qld__accordion-group
          {{ metadata.theme.value }}
        "
      >
        {{#ifCond metadata.toggle_all.value '==' 'yes'}}
          <div class="qld__accordion__toggle">
            <button
              class="qld__accordion__toggle-btn qld__accordion__toggle-btn--closed"
              type="button"
              aria-expanded="false"
            >
              <span>Open all</span>
              <svg
                class="qld__icon qld__icon--xs"
                aria-hidden="true"
                xmlns="http://www.w3.org/2000/svg"
              >
                <use
                  href="{{ @root.site.metadata.coreSiteIcons.value }}#chevron-up"
                ></use>
              </svg>
            </button>
          </div>
        {{/ifCond}}
        {{#printAccordion metadata}}
          {{#ifCond this.content '!=' ''}}
            <div class="qld__accordion">
              <{{../metadata.title_level.value}}>
                  <button class="qld__accordion__title js-qld__accordion qld__accordion--closed" aria-controls="accordion-group-{{../assetid}}-{{this.fieldid}}" aria-expanded="false" type="button">
                      {{this.title}}
                      <svg
                        class="qld__icon qld__icon--md qld__accordion__icon"
                        aria-hidden="true"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <use
                          href="{{ @root.site.metadata.coreSiteIcons.value }}#chevron-up"
                        ></use>
                      </svg>
                  </button>
              </{{../metadata.title_level.value}}>
              <div
                id="accordion-group-{{ ../assetid }}-{{ this.fieldid }}"
                class="qld__accordion__body qld__accordion--closed"
              >
                <div class="qld__accordion__body-wrapper">
                  {{{ this.content }}}
                </div>
              </div>
            </div>
          {{/ifCond}}
        {{/printAccordion}}

      </div>

      {{!-- {{#ifCond current.data.metadata.pageType.value '==' 'landing'}} --}}
    </div>
  </section>
{{/with}}
{{!-- {{/ifCond}} --}}
