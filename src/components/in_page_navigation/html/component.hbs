{{!-- qld__hide-on-print drops the whole section from print output; see the
print utilities in src/styles/imports/utilities.scss --}}
<section class="qld__body qld__hide-on-print">
  <div class="container-fluid">
    <nav
      class="qld__inpage-nav-links"
      aria-label="In page navigation"
      data-headingType="{{ component.data.metadata.headingType.value }}"
    >
      <h2 class="qld__inpage-nav-links__heading">
        {{{ component.data.metadata.heading.value }}}
      </h2>
      <ul class="qld__link-list"></ul>
    </nav>
  </div>
</section>
